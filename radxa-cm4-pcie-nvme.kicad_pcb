(kicad_pcb
  (version 20240108)
  (generator "master_parallel_orchestrator")
  (generator_version "8.0")
  (general (thickness 1.6) (legacy_teardrops no))
  (paper "A4")
  (layers
    (0 "F.Cu" signal) (1 "In1.Cu" power) (2 "In2.Cu" power) (31 "B.Cu" signal)
    (36 "B.SilkS" user "B.Silkscreen") (37 "F.SilkS" user "F.Silkscreen")
    (38 "B.Mask" user) (39 "F.Mask" user) (44 "Edge.Cuts" user)
  )
  (setup (pad_to_mask_clearance 0.05) (pcbplotparams (layerselection 0x00010fc_ffffffff) (usegerberextensions yes) (outputdirectory "gerbers/")))
  (gr_line (start 0 0) (end 55 0) (stroke (width 0.15) (type solid)) (layer "Edge.Cuts"))
  (gr_line (start 55 0) (end 55 40) (stroke (width 0.15) (type solid)) (layer "Edge.Cuts"))
  (gr_line (start 55 40) (end 0 40) (stroke (width 0.15) (type solid)) (layer "Edge.Cuts"))
  (gr_line (start 0 40) (end 0 0) (stroke (width 0.15) (type solid)) (layer "Edge.Cuts"))
)
